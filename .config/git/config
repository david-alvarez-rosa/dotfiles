[user]
  name = David Álvarez Rosa
  email = david@alvarezrosa.com
  signingkey = D84726EC15C55C1E
[alias]
  hist = log --graph --oneline
  st = status
[commit]
  gpgsign = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[hook "no-attribution-msg"]
	command = ~/.config/git/hooks/commit-msg
	event = commit-msg
[hook "no-attribution-push"]
	command = ~/.config/git/hooks/pre-push
	event = pre-push
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[github]
	user = david-alvarez-rosa
[pull]
	rebase = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[rerere]
	enabled = true
	autoupdate = true
