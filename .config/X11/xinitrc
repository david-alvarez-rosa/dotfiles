xremap ~/.config/xremap/config.yml &
sleep 2 && setxkbmap -layout us,es -option compose:ralt && xset r rate 275 60 &
unclutter --timeout 2 --ignore-scrolling &
xrdb -merge ~/.config/X11/Xresources
~/.local/bin/keepassxc-tpm-unlock &
dunst &
picom &
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=i3
exec i3
