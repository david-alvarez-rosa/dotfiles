Match originalhost homelab exec "grep -qi 08:7b:12:d7:95:77 /proc/net/arp"
     HostName 192.168.1.129
     HostKeyAlias ssh.alvarezrosa.com

Host bridge
     HostName ssh.alvarezrosa.com
     Port 2222

Host homelab
     HostName ssh.alvarezrosa.com
     ObscureKeystrokeTiming no
     ServerAliveInterval 5

Host homelab-lte homelab-lte-digi
     HostName 10.0.1.2
     HostKeyAlias ssh.alvarezrosa.com
     ProxyJump root@bridge

Host homelab-lte-lowi
     HostName 10.0.2.2
     HostKeyAlias ssh.alvarezrosa.com
     ProxyJump root@bridge

Host tunnel
     ProxyCommand /usr/bin/cloudflared access ssh --hostname tunnel.alvarezrosa.com

Host *
     AddKeysToAgent 96h
     IdentityFile ~/.ssh/id_ed25519
     ControlMaster auto
     ControlPersist 12h
     ControlPath ~/.ssh/cm-%C
     ServerAliveInterval 15
     ServerAliveCountMax 3
     ConnectTimeout 10
