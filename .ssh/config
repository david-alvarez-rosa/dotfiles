Host *
     AddKeysToAgent 96h
     IdentityFile ~/.ssh/id_ed25519
     ControlMaster auto
     ControlPersist 30m
     ControlPath ~/.ssh/cm-%C

Host bridge
     HostName ssh.alvarezrosa.com
     Port 2222

Host homelab
     HostName ssh.alvarezrosa.com

Host tunnel
     ProxyCommand /usr/bin/cloudflared access ssh --hostname tunnel.alvarezrosa.com
     ServerAliveInterval 30
     ServerAliveCountMax 3
