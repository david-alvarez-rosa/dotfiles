#!/usr/bin/env sh
set -eux

resize() {
  i3-msg resize "$1" "$2" 40 px or 5 ppt | grep -q '"success":true' ||
    i3-msg resize "$3" "$4" 40 px or 5 ppt
}

case "$1" in
  up) resize grow up shrink down ;;
  down) resize shrink up grow down ;;
  left) resize shrink right grow left ;;
  right) resize grow right shrink left ;;
esac
