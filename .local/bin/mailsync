#!/usr/bin/env sh

sync_one() { flock "${XDG_RUNTIME_DIR:-/tmp}/mbsync-$1.lock" mbsync -c ~/.config/isync/mbsyncrc "$1"; }

out=$(sync_one "${1:-personal}")
printf '%s\n' "$out"

[ -n "${MAILSYNC_NO_INDEX:-}" ] && exit 0
case $out in
	*"Near: +0 *0 #0 -0"*) ;;
	*) emacsclient -e '(dalvrosa/mu4e-index-soon)' >/dev/null 2>&1 || true ;;
esac
